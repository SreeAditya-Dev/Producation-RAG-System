VITE_API_KEY=your-api-key-here

# Leave both unset for local dev (Vite's dev-server proxy forwards /api, /health,
# /ws to http://localhost:8000). Set both when deploying the frontend to a
# different host than the backend (e.g. Vercel frontend + Azure backend).
VITE_API_BASE_URL=https://your-backend.azurewebsites.net
VITE_WS_BASE_URL=wss://your-backend.azurewebsites.net
